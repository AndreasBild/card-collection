# Auto detect text files and normalize line endings to LF across OS & CI
* text=auto eol=lf

# Executables & scripts must strictly retain LF line endings
mvnw text eol=lf
mvnw.cmd text eol=crlf
*.sh text eol=lf
*.bash text eol=lf

# Source code & templates
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
